NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/pollify
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-random-32-character-minimum-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-character-minimum-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=12
OTP_SALT_ROUNDS=10
OTP_EXPIRY_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=example-user
SMTP_PASS=example-password
SMTP_FROM=no-reply@example.com
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=<SECRET_a8267acd>ecret

# Production overrides (set in Vercel dashboard, not committed):
# NODE_ENV=production
# PORT=auto
# MONGO_URI=mongodb+srv://...
# CORS_ORIGIN=https://your-production-domain.com
# FRONTEND_URL=https://your-production-domain.com
# COOKIE_SECURE=true
